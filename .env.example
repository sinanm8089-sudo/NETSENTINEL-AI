# NETSENTINEL AI — Environment Configuration Template
# Copy to .env to customize local or production settings

# Database (Defaults to local SQLite for zero-config operation; set PostgreSQL URI for production)
DATABASE_URL=sqlite:///./netsentinel.db

# Security & JWT
SECRET_KEY=netsentinel-enterprise-secret-key-change-in-prod-2026

# Scanner Execution Settings
MAX_CONCURRENT_SCANS=3
SCAN_HOST_TIMEOUT_SECONDS=120
SCAN_MAX_RATE_PPS=500
PREFER_REAL_NMAP=false

# Hybrid AI Settings (Core scanner & statistical risk engine work 100% offline without AI)
# Options: AUTO | STATISTICAL_OFFLINE | LOCAL_OLLAMA | CLOUD_GEMINI | CLOUD_OPENAI
AI_PROVIDER_PREFERENCE=AUTO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SOC Dashboard Refresh Interval
DASHBOARD_REFRESH_SECONDS=8

